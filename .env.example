# Reference only — this file is not consumed directly. Real values are
# fetched from Google Cloud Secret Manager (project: immoo-506522) and
# written to a gitignored .env automatically by direnv on `cd`, or manually
# via `bash scripts/fetch-secrets.sh` / `poe scrape`.
# See UML/secrets-management.md for how the pieces fit together.

SCRAPER_API_KEY=sk_live_default_secret_key
ZENROWS_API_KEY=your_zenrows_api_key
GEMINI_API_KEY=your_gemini_api_key
STREAMESTATE_API_KEY=your_streamestate_api_key

GOOGLE_SHEET_NAME=Immoo Live Listing
USE_MOCK=true
GOOGLE_SHEETS_MASTER_TEMPLATE_ID=18dvMh-rbU7dof6EtjKH8PSSoI632qlbQ9_4E_5oSuEE
GOOGLE_DRIVE_STAGING_FOLDER_ID=0ABCJ9B8w13-pUk9PVA

# Full service-account key JSON, compacted to one line. Never fill this in
# by hand — it's generated by scripts/fetch-secrets.sh.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"...","client_email":"..."}
